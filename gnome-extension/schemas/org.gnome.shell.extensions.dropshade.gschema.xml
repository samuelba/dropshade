<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.dropshade" path="/org/gnome/shell/extensions/dropshade/">
    <key name="toggle-shortcut" type="as">
      <default>['F12']</default>
      <summary>Shortcut that shows or hides the terminal</summary>
    </key>
    <key name="command" type="as">
      <default>[]</default>
      <summary>Command that starts Dropshade</summary>
      <description>Empty means "dropshade" from PATH.</description>
    </key>
    <key name="width-fraction" type="d">
      <range min="0.2" max="1.0"/>
      <default>1.0</default>
      <summary>Width as a fraction of the monitor work area</summary>
    </key>
    <key name="height-fraction" type="d">
      <range min="0.1" max="1.0"/>
      <default>0.5</default>
      <summary>Height as a fraction of the monitor work area</summary>
    </key>
    <key name="animation-duration" type="u">
      <range min="0" max="1000"/>
      <default>180</default>
      <summary>Slide animation duration in milliseconds (0 disables it)</summary>
    </key>
    <key name="monitor" type="s">
      <choices>
        <choice value="pointer"/>
        <choice value="primary"/>
      </choices>
      <default>'pointer'</default>
      <summary>Monitor the terminal appears on</summary>
    </key>
  </schema>
</schemalist>
