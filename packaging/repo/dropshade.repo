# Updates for Dropshade, from https://github.com/samuelba/dropshade. Installed by the dropshade
# package; to stop them, set enabled=0 rather than deleting this file.
#
# The repository's metadata is signed and lists every package's checksum, so the packages
# themselves need no signature of their own (gpgcheck=0).
[dropshade]
name=Dropshade
baseurl=https://samuelba.github.io/dropshade/rpm
enabled=1
gpgcheck=0
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-dropshade
metadata_expire=6h
