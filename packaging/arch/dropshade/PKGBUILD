# Maintainer: Samuel Bachmann <samuel.bachmann@gmail.com>
pkgname=dropshade
pkgver=0.9.0 # x-release-please-version
pkgrel=1
pkgdesc="A drop-down terminal for Linux"
arch=('x86_64' 'aarch64')
url="https://github.com/samuelba/dropshade"
license=('MIT' 'GPL-2.0-or-later')
depends=('glibc' 'libgcc' 'libxkbcommon' 'wayland' 'hicolor-icon-theme')
makedepends=('cargo')
checkdepends=('ttf-dejavu')
optdepends=(
    'vulkan-icd-loader: GPU rendering instead of the CPU fallback'
    'gnome-shell: drop down on GNOME through the bundled Shell extension'
    'xdg-desktop-portal: global hotkey on KDE Plasma and Hyprland'
    'libxcursor: X11 sessions'
    'libxi: X11 sessions'
    'libxrandr: X11 sessions'
)
options=('!debug' '!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release -p dropshade
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo test --frozen --workspace
}

package() {
    cd "$pkgname-$pkgver"
    local app_id=dev.samuelba.Dropshade
    local extension="$pkgdir/usr/share/gnome-shell/extensions/dropshade@samuelba.dev"

    install -Dm755 target/release/dropshade -t "$pkgdir/usr/bin/"
    install -Dm644 "packaging/$app_id.desktop" -t "$pkgdir/usr/share/applications/"
    install -Dm644 "packaging/$app_id.metainfo.xml" -t "$pkgdir/usr/share/metainfo/"
    install -Dm644 packaging/icons/hicolor/scalable/apps/*.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
    install -Dm644 packaging/icons/hicolor/symbolic/apps/*.svg -t "$pkgdir/usr/share/icons/hicolor/symbolic/apps/"

    install -Dm644 gnome-extension/*.js gnome-extension/metadata.json gnome-extension/LICENSE -t "$extension/"
    install -Dm644 gnome-extension/icons/*.svg -t "$extension/icons/"
    install -Dm644 gnome-extension/schemas/*.gschema.xml -t "$pkgdir/usr/share/glib-2.0/schemas/"

    install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 gnome-extension/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-gnome-extension"
}
