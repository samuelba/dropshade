{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-commit-authors": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "dropshade",
      "bump-minor-pre-major": true,
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='dropshade')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='dropshade-term')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='dropshade-config')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='dropshade-session')].version" },
        { "type": "json", "path": "gnome-extension/metadata.json", "jsonpath": "$['version-name']" },
        { "type": "generic", "path": "packaging/arch/dropshade/PKGBUILD" },
        { "type": "generic", "path": "packaging/arch/dropshade-bin/PKGBUILD" }
      ]
    }
  }
}
